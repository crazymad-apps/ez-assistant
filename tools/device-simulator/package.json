{
  "name": "@ez-assistant/device-simulator",
  "version": "0.21.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.node.json && vite build",
    "clean": "rm -rf dist",
    "dev": "tsx src/node/main.ts",
    "lint": "oxlint src tests vite.config.ts vitest.config.ts playwright.config.ts",
    "start": "node dist/node/main.js",
    "test": "vitest run --root .",
    "test:m5-e2e": "node tests/m5-e2e.mjs",
    "test:m6-e2e": "node tests/m6-e2e.mjs",
    "test:m7-e2e": "cargo build -p assistant-runtime-host && node tests/m7-e2e.mjs",
    "test:m8-e2e": "cargo build -p assistant-runtime-host && node tests/m8-e2e.mjs",
    "test:e2e": "npm run build && playwright test && npm run test:m8-e2e",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@noble/curves": "2.2.0",
    "bonjour-service": "1.4.4",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "oxlint": "1.78.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
