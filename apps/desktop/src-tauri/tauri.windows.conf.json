{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["msi"],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "wix": {
        "template": "wix/main.wxs",
        "language": "en-US"
      }
    },
    "icon": ["icons/windows/icon.ico", "icons/windows/32x32.png", "icons/windows/128x128.png", "icons/windows/128x128@2x.png"]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EZ Assistant",
        "width": 1000,
        "height": 700,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "decorations": false
      }
    ]
  }
}
