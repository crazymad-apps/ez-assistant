{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["deb"],
    "category": "Utility",
    "shortDescription": "EZ Assistant Desktop",
    "longDescription": "EZ Assistant desktop application with bundled local Runtime Host and smart device support.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "section": "utility",
        "priority": "optional"
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EZ Assistant",
        "width": 1000,
        "height": 700,
        "minWidth": 920,
        "minHeight": 520,
        "center": true,
        "decorations": false
      }
    ]
  }
}
