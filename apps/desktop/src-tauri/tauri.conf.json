{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EZ Assistant",
  "version": "0.1.0",
  "identifier": "com.ez-assistant.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EZ Assistant",
        "width": 1000,
        "height": 700,
        "minWidth": 720,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
