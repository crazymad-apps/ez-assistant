{
  "name": "@ez-assistant/desktop",
  "private": true,
  "version": "0.20.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:protocol && tsc && vite build",
    "generate:icon:macos": "node scripts/generate-macos-icon.mjs",
    "check:icon:macos": "node scripts/generate-macos-icon.mjs --check",
    "generate:icon:tray:macos": "node scripts/generate-macos-tray-icon.mjs",
    "check:icon:tray:macos": "node scripts/generate-macos-tray-icon.mjs --check",
    "generate:protocol": "cargo run -p assistant-protocol --example export_typescript",
    "check:protocol": "cargo run -p assistant-protocol --example export_typescript -- --check",
    "lint": "oxlint --ignore-pattern src/generated/** src tests vite.config.ts vitest.config.ts playwright.config.ts",
    "test": "npm run check:protocol && vitest run",
    "test:e2e": "cargo build -p assistant-runtime-host && playwright test",
    "preview": "vite preview",
    "prepare:sidecar": "cargo build -p assistant-runtime-host --release && node scripts/prepare-sidecar.mjs",
    "release:macos": "node scripts/release-macos.mjs",
    "verify:macos-release": "node scripts/verify-macos-release.mjs",
    "tauri": "node scripts/run-tauri.mjs"
  },
  "dependencies": {
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@tauri-apps/api": "2.11.1",
    "mobx": "7.0.0",
    "mobx-react-lite": "5.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "streamdown": "2.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "29.1.1",
    "oxlint": "1.78.0",
    "sass": "1.102.0",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "packageManager": "npm@10.9.2"
}
