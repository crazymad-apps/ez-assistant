# Enterprise Center 标准配置（Node.js 24 / PostgreSQL 16.14）
# 复制为本目录的 .env，填写数据库连接；.env 已被 Git 忽略，不提交真实凭据。
# 常规启动不自动加载 .env；合并制品使用：node --env-file=.env dist/main.js
# 前后端联调：npm run dev 自动加载 .env；PUBLIC_ORIGIN 改为 http://127.0.0.1:7310。
# 仅后端非监听启动：node --env-file=.env dist/main.js --api-only
# 默认启动必须存在 public/admin/ 正式产物；缺失时在连接数据库前退出。
# 已存在的进程环境变量优先于文件配置。

# 【必填，无默认值】升级与业务共用一个数据库账号，库须提前创建。
# 账号需要本应用专用库/schema 的建表、改表及读写权限，不要求超级用户。
# 示例（替换账号、密码和目标库后使用）：
# postgresql://center_app:replace-me@127.0.0.1:55432/ez_center_dev
# 用户名/密码中的特殊字符需进行 URL 编码；URI 查询参数仅支持 sslmode。
CENTER_DATABASE_URL=

# 【可选，默认 true】仅接受 true / false。
# true：启动前执行待完成的升级 SQL；首次安装同时初始化超级管理员。
# false：启动只读检查版本，空库/待升级库拒绝启动；需手动执行升级命令。
# 既有库升级前仍须核对目标、备份并恢复验证，不以本开关替代操作确认。
CENTER_DATABASE_AUTO_UPGRADE=true

# 【可选，默认 127.0.0.1 / 7320】监听地址必须为 IP，不接受域名。
# 默认只监听本机；需要容器或其他机器访问时按部署拓扑改为 0.0.0.0 等地址。
CENTER_HOST=127.0.0.1
CENTER_PORT=7320

# 【必填，无默认值】浏览器实际访问的精确 origin，含协议及必要端口。
# 不包含路径或末尾斜线，例如 https://center.example.com。
# 用于全局请求来源检查，不会为 Node 服务自动启用 TLS；后端不操作 Cookie。
CENTER_PUBLIC_ORIGIN=http://127.0.0.1:7320

# 【可选，默认关闭】此模板为本机开发显式开启；只有字面值 true 才开启。
# 仅在监听地址和 public origin 都属于本机时允许 HTTP。
CENTER_ALLOW_HTTP_LOOPBACK=true

# 生产部署：将 CENTER_PUBLIC_ORIGIN 改为实际 HTTPS 地址，
# 将 CENTER_ALLOW_HTTP_LOOPBACK 改为 false，TLS 由 HTTPS 反向代理终止。
# CENTER_HOST 按代理/容器拓扑选择；不要仅为配置 HTTPS origin 就开放全部网卡。
# 默认超级管理员 admin / 123456 由初始 SQL 创建，正式使用前修改密码。
# 没有独立初始管理员配置、JWT 秘钥或第二个数据库账号配置。
# CENTER_TEST_* 仅属于隔离测试，不放入应用运行配置。
